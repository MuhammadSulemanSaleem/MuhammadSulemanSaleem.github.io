---
import BaseLayout from '../../layouts/BaseLayout/index.astro';
import Navbar from '../../components/Navbar/index.astro';
---

<BaseLayout title="Contact — Suleman" description="Get in touch with Muhammad Suleman Saleem">
  <Navbar />
  <section class="coming-soon">
    <h1>Contact</h1>
    <p>Contact form coming soon.</p>
  </section>
</BaseLayout>

<style>
  .coming-soon {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background-color: var(--extra-light);
    color: var(--text-dark);
    font-family: "Poppins", sans-serif;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 600;
    color: var(--primary-color);
  }

  p {
    color: var(--text-light);
    font-size: 1.1rem;
  }
</style>
