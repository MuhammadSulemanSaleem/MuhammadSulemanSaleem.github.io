                  <span class="hc-cap-chip hc-cap-chip--top">3 steps synced</span>
                  <div class="hc-cap-flow">
                    <div class="hc-cap-flow__step">
                      <span class="hc-cap-flow__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg>
                      </span>
                      <span class="hc-cap-flow__label">Trigger</span>
                    </div>
                    <svg class="hc-cap-flow__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                    <div class="hc-cap-flow__step">
                      <span class="hc-cap-flow__icon hc-cap-flow__icon--accent">
                        <svg class="hc-cap-flow__icon-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path><path d="M16 16h5v5"></path></svg>
                      </span>
                      <span class="hc-cap-flow__label">Automation</span>
                    </div>
                    <svg class="hc-cap-flow__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                    <div class="hc-cap-flow__step">
                      <span class="hc-cap-flow__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path d="m9 11 3 3L22 4"></path></svg>
                      </span>
                      <span class="hc-cap-flow__label">Result</span>
                    </div>
                  </div>
                </>
              )}
            </div>
          </div>
        ))}
        </div>
      </section>

      <!-- Key Achievements -->
      <section class="hc-section" id="achievements">
        <div class="hc-section__header hc-section__header--left" data-aos="fade-up">
          <h2 class="hc-heading">Key Achievements</h2>
          <p class="hc-section__subtitle">Milestones that mattered along the way.</p>
        </div>
        <div class="rs-card-grid">
          {achievements.map((a, i) => (
            <div class="hc-card rs-card rs-card--achievement" data-aos="fade-up" data-aos-delay={i * 60}>
              <div class="rs-card__icon"><i class={a.icon} aria-hidden="true"></i></div>
              <h3 class="rs-card__name">{a.name}</h3>
              <p class="rs-card__desc">{a.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Professional Experience -->
      <section class="hc-section" id="experience">
        <div class="hc-section__header hc-section__header--left" data-aos="fade-up">
          <h2 class="hc-heading">Professional Experience</h2>
        </div>

        {experienceJobs.map((job) => (
          <section class="rs-job-group">
            <div class="rs-job__header rs-job-group__header" data-aos="fade-up">
              <div class="rs-job__header-main">
                {job.logo && <img src={job.logo} alt="" width="36" height="36" class="rs-job__logo" />}
                <div>
                  <p class="rs-job__title">{job.title}</p>
                  <p class="rs-job__company">{job.company}</p>
                </div>
              </div>
              <span class="rs-job__dates">{job.dates}</span>
            </div>
            {job.items.map((item, i) => (
              <div class="hc-card hc-work" data-aos="fade-up">
                <div class="hc-work__content">
                  <h3 class="hc-work__name">{item.name}</h3>
                  <dl class={`hc-work__breakdown ${i % 2 === 1 ? 'hc-work__breakdown--violet' : ''}`}>
                    <div class="hc-work__point">
                      <dt>Challenge</dt>
                      <dd>{item.challenge}</dd>
                    </div>
                    <div class="hc-work__point">
                      <dt>Solution</dt>
                      <dd>{item.solution}</dd>
                    </div>
                    <div class="hc-work__point">
                      <dt>Impact</dt>
                      <dd>{item.impact}</dd>
                    </div>
                  </dl>
                  {item.note && (
                    <p class="rs-note"><i class="ri-lock-line" aria-hidden="true"></i> {item.note}</p>
                  )}
                  {item.caseStudy !== false && (
                    <div class="hc-work__actions">
                      <span class="hc-btn hc-btn--primary hc-btn--sm">Case Study</span>
                      <span class="hc-icon-btn" aria-hidden="true">
                        <span class="hc-icon-btn__track">
                          <i class="ri-arrow-right-line" aria-hidden="true"></i>
                          <i class="ri-arrow-right-line" aria-hidden="true"></i>
                        </span>
                      </span>
                    </div>
                  )}
                </div>
                <div class={`hc-work__tile hc-work__tile--${i % 2 === 1 ? 'violet' : 'blue'}`}>
                  <span class="hc-work__mark">{item.mark}</span>
                  <span class="hc-work__tile-name">{item.name}</span>
                  <span class="hc-work__tile-metric">{item.metric}</span>
                </div>
              </div>
            ))}
          </section>
        ))}
      </section>

      <!-- Relevant Experience -->
      <section class="hc-section">
        <div class="hc-section__header hc-section__header--left" data-aos="fade-up">
          <h2 class="hc-heading">Relevant Experience</h2>
        </div>
        <div class="hc-card rs-job" data-aos="fade-up">
          <div class="rs-job__header">
            <div class="rs-job__header-main">
              {relevantExperience.logo && <img src={relevantExperience.logo} alt="" width="36" height="36" class="rs-job__logo" />}
              <div>
                <p class="rs-job__title">{relevantExperience.title}</p>
                <p class="rs-job__company">{relevantExperience.company}</p>
              </div>
            </div>
            <span class="rs-job__dates">{relevantExperience.dates}</span>
          </div>
          <div class="rs-card-grid rs-card-grid--nested">
            {relevantExperience.items.map((item) => (
              <div class="rs-card rs-card--nested">
                {(item.badge || item.metric) && (
                  <div class="rs-card__top">
                    {item.badge && <span class="rs-card__badge">{item.badge}</span>}
                    {item.metric && <span class="rs-card__metric">{item.metric}</span>}
                  </div>
                )}
                <h3 class="rs-card__name">{item.name}</h3>
                <p class="rs-card__desc">{item.description}</p>
                {item.tech.length > 0 && (
                  <div class="rs-card__tech">
                    {item.tech.map((t) => (
                      <span class="rs-tag">
                        {renderTech(t)
                          ? <img src={renderTech(t)} alt="" width="12" height="12" />
                          : <i class="ri-price-tag-3-line" aria-hidden="true"></i>}
                        {t}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Education -->
      <section class="hc-section" id="education">
        <div class="hc-section__header hc-section__header--left" data-aos="fade-up">
          <h2 class="hc-heading">Education</h2>
        </div>
        <div class="hc-card rs-panel" data-aos="fade-up">
          <div class="rs-edu-list">
            {education.map((e) => (
              <div class="rs-edu-item">
                <div class="rs-edu-item__left">
                  <img src={e.logo} alt="" width="36" height="36" class="rs-edu-item__logo" />
                  <div>
                    <p class="rs-edu-item__degree">{e.degree}</p>
                    <p class="rs-edu-item__institution">{e.institution}</p>
                    {e.note && <p class="rs-edu-item__note">{e.note}</p>}
                  </div>
                </div>
                <span class="rs-edu-item__dates">{e.dates}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Certifications -->
      <section class="hc-section" id="certifications">
        <div class="hc-section__header hc-section__header--left" data-aos="fade-up">
          <h2 class="hc-heading">Certifications</h2>
        </div>
        <div class="hc-card rs-panel" data-aos="fade-up">
          <ul class="rs-cert-grid">
            {certifications.map((c) => {
              const Tag = c.href ? 'a' : 'div';
              const linkProps = c.href ? { href: c.href, target: '_blank', rel: 'noopener noreferrer' } : {};
              return (
                <li>
                  <Tag class="rs-cert" {...linkProps}>
                    <span class="rs-cert__name">{c.name}</span>
                    <span class="rs-cert__issuer">
                      <img src={c.icon} alt="" width="12" height="12" />
                      {c.issuer}
                    </span>
                  </Tag>
                </li>
              );
            })}
          </ul>
        </div>
      </section>

      <!-- Other Skills & Tools -->
      <section class="hc-section rs-noprint" id="skills">
        <div class="hc-section__header hc-section__header--left" data-aos="fade-up">
          <h2 class="hc-heading">Other Skills &amp; Tools</h2>
        </div>
        <div class="rs-skills-grid">
          {skillGroups.map((group, i) => (
            <div class="hc-card rs-skill-card" data-aos="fade-up" data-aos-delay={i * 40}>
              <p class="rs-skill-card__label">{group.label}</p>
              <div class="rs-skill-card__tags">
                {group.items.map((item) => (
                  <span class="rs-tag">
                    {renderTech(item)
                      ? <img src={renderTech(item)} alt="" width="12" height="12" />
                      : <i class="ri-price-tag-3-line" aria-hidden="true"></i>}
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- CTA band -->
      <section class="hc-section rs-noprint">
        <div class="hc-card hc-cta" data-aos="fade-up">
          <div class="hc-cta__dots" aria-hidden="true"></div>
          <div class="hc-cta__content">
            <p class="hc-cta__status"><span class="hc-cta__dot"></span>Available for work</p>
            <h2 class="hc-heading">Like what you see<br />on paper?</h2>
            <p class="hc-cta__subtitle">Let's talk about what you're building and how I can help ship it.</p>
          </div>
          <div class="hc-cta__actions">
            <a href="/contact" class="hc-btn hc-btn--primary">Get in touch</a>
          </div>
        </div>
      </section>

    </main>

    <HcFooter />
  </div>

  <script>
    const hcStatNumbers = document.querySelectorAll<HTMLElement>('.hc-stat__number');
    const hcPrefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!hcPrefersReducedMotion && hcStatNumbers.length) {
      const animateCount = (el: HTMLElement) => {
        const match = el.textContent?.trim().match(/^(\d+)(.*)$/);
        if (!match) return;
        const target = parseInt(match[1], 10);
        const suffix = match[2];
        const duration = 1100;
        const start = performance.now();

        const step = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = `${Math.round(eased * target)}${suffix}`;
          if (progress < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };

      const hcStatsObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animateCount(entry.target as HTMLElement);
              hcStatsObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.4 }
      );

      hcStatNumbers.forEach((el) => hcStatsObserver.observe(el));
    }
  </script>
</BaseLayout>
