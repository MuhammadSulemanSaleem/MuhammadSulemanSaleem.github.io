---

<BaseLayout
  title="Resume — Muhammad Suleman Saleem"
  description="Resume of Muhammad Suleman Saleem, Full-Stack Software Engineer and AI Product Engineer."
>
  <div class="hc-page">
    <HcNav />

    <!-- Print-only header (hidden on screen) -->
    <div class="rs-print-header">
      <h1>Muhammad Suleman Saleem</h1>
      <p>
        Shahdara Town, Lahore, Pakistan &nbsp;·&nbsp; +92 307 1123666 &nbsp;·&nbsp;
        rana.suleman2297@gmail.com &nbsp;·&nbsp; linkedin.com/in/muhammad-suleman-saleem
      </p>
    </div>

    <main class="hc-main">

      <!-- Hero -->
      <section class="hc-section">
        <div class="hc-card rs-hero rs-panel" data-aos="fade-up">
          <p class="hc-eyebrow">Resume</p>
          <h1 class="rs-hero__name">Muhammad Suleman Saleem</h1>
          <p class="rs-hero__role">Full-Stack Software Engineer &amp; AI Product Engineer</p>
          <p class="rs-hero__focus">LLM Systems &amp; Automation &nbsp;·&nbsp; Production-Ready AI Solutions</p>
          <ul class="rs-hero__tech" aria-label="Core technologies">
            {coreTech.map((t) => (
              <li><img src={t.icon} alt="" width="14" height="14" />{t.name}</li>
            ))}
          </ul>
          <div class="rs-hero__actions">
            <a
              href="/Muhammad_Suleman_Saleem_Resume.pdf"
              download="Muhammad_Suleman_Saleem_Resume.pdf"
              class="hc-btn hc-btn--primary"
            >
              <i class="ri-download-2-line" aria-hidden="true"></i>
              Download Resume
            </a>
            <a
              href="https://linkedin.com/in/muhammad-suleman-saleem"
              target="_blank"
              rel="noopener noreferrer"
              class="hc-btn hc-btn--outline"
            >
              <i class="ri-linkedin-box-fill" aria-hidden="true"></i>
              LinkedIn Profile
            </a>
          </div>
        </div>
      </section>

      <!-- Stats -->
      <section class="hc-section hc-section--tight rs-noprint">
        <div class="hc-card hc-stats" data-aos="fade-up">
          {stats.map((s) => (
            <div class="hc-stat">
              <span class="hc-stat__number">{s.number}</span>
              <span class="hc-stat__label">{s.label}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Professional Summary -->
      <section class="hc-section" id="summary">
        <div class="hc-card rs-panel" data-aos="fade-up">
          <p class="hc-eyebrow">Professional Summary</p>
          <p class="rs-summary">
            Full-stack Software Engineer with <strong>5+ years</strong> of experience building
            cross-platform mobile, web, and desktop applications and, more recently, production
            AI/LLM-powered systems. Deep expertise in <strong>Flutter and Dart</strong>, with
            additional cross-platform mobile experience in <strong>Expo and React Native</strong>,
            desktop development with <strong>Electron</strong>, and hands-on backend experience in
            <strong>Node.js, Nest.js, Express, and Next.js</strong>. Over the past two years I have
            shifted into building AI-integrated products — <strong>RAG pipelines</strong>,
            <strong>multi-provider LLM orchestration</strong> (Claude, OpenAI, ElevenLabs), and
            <strong>workflow automation</strong> platforms using n8n — alongside continued
            Flutter/mobile delivery. I focus on scalable architecture, clean code, and shipping
            features end-to-end, from UI to database to third-party integrations. Known for
            mentoring developers, automating repetitive business workflows, and translating
            ambiguous requirements into working production systems.
          </p>
        </div>
      </section>

      <!-- Areas of Expertise -->
      <section class="hc-section" id="skills">
        <div class="hc-card rs-panel" data-aos="fade-up">
          <p class="hc-eyebrow">Areas of Expertise</p>
          <ul class="rs-expertise">
            {expertise.map((e) => (
              <li><img src={e.icon} alt="" width="14" height="14" />{e.label}</li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Key Achievements -->
      <section class="hc-section" id="achievements">
        <div class="hc-section__header hc-section__header--left" data-aos="fade-up">
          <h2 class="hc-heading">Key Achievements</h2>
        </div>
        <div class="rs-card-grid">
          {achievements.map((a, i) => (
            <div class="hc-card rs-card" data-aos="fade-up" data-aos-delay={i * 60}>
              <div class="rs-card__top">
                <span class="rs-card__badge">{a.badge}</span>
                <span class="rs-card__metric">{a.metric}</span>
              </div>
              <h3 class="rs-card__name">{a.name}</h3>
              <p class="rs-card__desc">{a.description}</p>
              {a.tech.length > 0 && (
                <div class="rs-card__tech">
                  {a.tech.map((t) => (
                    <span class="rs-tag">
                      {renderTech(t)
                        ? <img src={renderTech(t)} alt="" width="12" height="12" />
                        : <i class="ri-price-tag-3-line" aria-hidden="true"></i>}
                      {t}
                    </span>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- Professional Experience -->
      <section class="hc-section" id="experience">
        <div class="hc-section__header hc-section__header--left" data-aos="fade-up">
          <h2 class="hc-heading">Professional Experience</h2>
        </div>

        {experienceJobs.map((job) => (
          <div class="hc-card rs-job" data-aos="fade-up">
            <div class="rs-job__header">
              <div class="rs-job__header-main">
                {job.logo && <img src={job.logo} alt="" width="36" height="36" class="rs-job__logo" />}
                <div>
                  <p class="rs-job__title">{job.title}</p>
                  <p class="rs-job__company">{job.company}</p>
                </div>
              </div>
              <span class="rs-job__dates">{job.dates}</span>
            </div>
            <div class="rs-card-grid rs-card-grid--nested">
              {job.items.map((item) => (
                <div class="rs-card rs-card--nested">
                  {(item.badge || item.metric) && (
                    <div class="rs-card__top">
                      {item.badge && <span class="rs-card__badge">{item.badge}</span>}
                      {item.metric && <span class="rs-card__metric">{item.metric}</span>}
                    </div>
                  )}
                  <h3 class="rs-card__name">{item.name}</h3>
                  <p class="rs-card__desc">{item.description}</p>
                  {item.tech.length > 0 && (
                    <div class="rs-card__tech">
                      {item.tech.map((t) => (
                        <span class="rs-tag">
                          {renderTech(t)
                            ? <img src={renderTech(t)} alt="" width="12" height="12" />
                            : <i class="ri-price-tag-3-line" aria-hidden="true"></i>}
                          {t}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </section>

      <!-- Relevant Experience -->
      <section class="hc-section">
        <div class="hc-section__header hc-section__header--left" data-aos="fade-up">
          <h2 class="hc-heading">Relevant Experience</h2>
        </div>
        <div class="hc-card rs-job" data-aos="fade-up">
          <div class="rs-job__header">
            <div class="rs-job__header-main">
              {relevantExperience.logo && <img src={relevantExperience.logo} alt="" width="36" height="36" class="rs-job__logo" />}
              <div>
                <p class="rs-job__title">{relevantExperience.title}</p>
                <p class="rs-job__company">{relevantExperience.company}</p>
              </div>
            </div>
            <span class="rs-job__dates">{relevantExperience.dates}</span>
          </div>
          <div class="rs-card-grid rs-card-grid--nested">
            {relevantExperience.items.map((item) => (
              <div class="rs-card rs-card--nested">
                {(item.badge || item.metric) && (
                  <div class="rs-card__top">
                    {item.badge && <span class="rs-card__badge">{item.badge}</span>}
                    {item.metric && <span class="rs-card__metric">{item.metric}</span>}
                  </div>
                )}
                <h3 class="rs-card__name">{item.name}</h3>
                <p class="rs-card__desc">{item.description}</p>
                {item.tech.length > 0 && (
                  <div class="rs-card__tech">
                    {item.tech.map((t) => (
                      <span class="rs-tag">
                        {renderTech(t)
                          ? <img src={renderTech(t)} alt="" width="12" height="12" />
                          : <i class="ri-price-tag-3-line" aria-hidden="true"></i>}
                        {t}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Education -->
      <section class="hc-section" id="education">
        <div class="hc-section__header hc-section__header--left" data-aos="fade-up">
          <h2 class="hc-heading">Education</h2>
        </div>
        <div class="hc-card rs-panel" data-aos="fade-up">
          <div class="rs-edu-list">
            {education.map((e) => (
              <div class="rs-edu-item">
                <div class="rs-edu-item__left">
                  <img src={e.logo} alt="" width="36" height="36" class="rs-edu-item__logo" />
                  <div>
                    <p class="rs-edu-item__degree">{e.degree}</p>
                    <p class="rs-edu-item__institution">{e.institution}</p>
                    {e.note && <p class="rs-edu-item__note">{e.note}</p>}
                  </div>
                </div>
                <span class="rs-edu-item__dates">{e.dates}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Certifications -->
      <section class="hc-section" id="certifications">
        <div class="hc-section__header hc-section__header--left" data-aos="fade-up">
          <h2 class="hc-heading">Certifications</h2>
        </div>
        <div class="hc-card rs-panel" data-aos="fade-up">
          <ul class="rs-cert-grid">
            {certifications.map((c) => {
              const Tag = c.href ? 'a' : 'div';
              const linkProps = c.href ? { href: c.href, target: '_blank', rel: 'noopener noreferrer' } : {};
              return (
                <li>
                  <Tag class="rs-cert" {...linkProps}>
                    <span class="rs-cert__name">{c.name}</span>
                    <span class="rs-cert__issuer">
                      <img src={c.icon} alt="" width="12" height="12" />
                      {c.issuer}
                    </span>
                  </Tag>
                </li>
              );
            })}
          </ul>
        </div>
      </section>

      <!-- Other Skills & Tools -->
      <section class="hc-section rs-noprint">
        <div class="hc-section__header hc-section__header--left" data-aos="fade-up">
          <h2 class="hc-heading">Other Skills &amp; Tools</h2>
        </div>
        <div class="rs-skills-grid">
          {skillGroups.map((group, i) => (
            <div class="hc-card rs-skill-card" data-aos="fade-up" data-aos-delay={i * 40}>
              <p class="rs-skill-card__label">{group.label}</p>
              <div class="rs-skill-card__tags">
                {group.items.map((item) => (
                  <span class="rs-tag">
                    {renderTech(item)
                      ? <img src={renderTech(item)} alt="" width="12" height="12" />
                      : <i class="ri-price-tag-3-line" aria-hidden="true"></i>}
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- CTA band -->
      <section class="hc-section rs-noprint">
        <div class="hc-card hc-cta" data-aos="fade-up">
          <div class="hc-cta__dots" aria-hidden="true"></div>
          <div class="hc-cta__content">
            <p class="hc-cta__status"><span class="hc-cta__dot"></span>Available for work</p>
            <h2 class="hc-heading">Like what you see<br />on paper?</h2>
            <p class="hc-cta__subtitle">Let's talk about what you're building and how I can help ship it.</p>
          </div>
          <div class="hc-cta__actions">
            <a href="/contact" class="hc-btn hc-btn--primary">Get in touch</a>
          </div>
        </div>
      </section>

    </main>

    <HcFooter />
  </div>
</BaseLayout>
