---

<BaseLayout
  title="Resume — Muhammad Suleman Saleem"
  description="Resume of Muhammad Suleman Saleem, Full-Stack Software Engineer and AI Product Engineer."
>
  <Navbar />
  <main class="resume-page" id="resume-page">
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('resumeView') !== 'plain') {
            document.getElementById('resume-page').setAttribute('data-view', 'card');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Layout toggle -->
    <div class="resume-toggle" role="group" aria-label="Resume layout">
      <span class="resume-toggle__label">Layout</span>
      <button type="button" class="resume-toggle__btn" data-view="card" aria-pressed="true">
        <i class="ri-layout-grid-line" aria-hidden="true"></i>
        Grid
      </button>
      <button type="button" class="resume-toggle__btn" data-view="plain" aria-pressed="false">
        <i class="ri-file-list-2-line" aria-hidden="true"></i>
        Plain
      </button>
    </div>

    <!-- Page hero -->
    <header class="page-hero">
      <div class="page-hero__inner" data-aos="fade-up">
        <p class="section__label">Resume</p>
        <h1 class="page-hero__title">Muhammad Suleman Saleem</h1>
        <p class="page-hero__role">Full-Stack Software Engineer &amp; AI Product Engineer</p>
        <p class="page-hero__focus">LLM Systems &amp; Automation &nbsp;·&nbsp; Production-Ready AI Solutions</p>
        <div class="page-hero__tech" aria-label="Core technologies">
          <span><span class="page-hero__tech-icon"><img src="/assets/svgs/flutter.svg" alt="" width="14" height="14" /></span>Flutter</span>
          <span><span class="page-hero__tech-icon"><img src="/assets/svgs/nodejs.svg" alt="" width="14" height="14" /></span>Node.js</span>
          <span><span class="page-hero__tech-icon"><img src="/assets/svgs/claude-api.svg" alt="" width="14" height="14" /></span>Claude API</span>
          <span><span class="page-hero__tech-icon"><img src="/assets/svgs/rag.svg" alt="" width="14" height="14" /></span>RAG</span>
          <span><span class="page-hero__tech-icon"><img src="/assets/svgs/n8n.svg" alt="" width="14" height="14" /></span>n8n</span>
          <span><span class="page-hero__tech-icon"><img src="/assets/svgs/react-native.svg" alt="" width="14" height="14" /></span>React Native</span>
          <span><span class="page-hero__tech-icon"><img src="/assets/svgs/electron.svg" alt="" width="14" height="14" /></span>Electron</span>
          <span><span class="page-hero__tech-icon"><img src="/assets/svgs/nestjs.svg" alt="" width="14" height="14" /></span>Nest.js</span>
          <span><span class="page-hero__tech-icon"><img src="/assets/svgs/typescript.svg" alt="" width="14" height="14" /></span>TypeScript</span>
        </div>
        <div class="page-hero__actions">
          <a
            href="/Muhammad_Suleman_Saleem_Resume.pdf"
            download="Muhammad_Suleman_Saleem_Resume.pdf"
            class="btn btn--primary"
          >
            <i class="ri-download-2-line" aria-hidden="true"></i>
            Download Resume
          </a>
          <a
            href="https://linkedin.com/in/muhammad-suleman-saleem"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--outline"
          >
            <i class="ri-linkedin-box-fill" aria-hidden="true"></i>
            LinkedIn Profile
          </a>
        </div>
      </div>
    </header>

    <!-- Resume content -->
    <div class="resume-wrap">
      <div class="resume">

        <!-- Shown only when printing (replaces the dark page-hero) -->
        <div class="print-header">
          <h1 class="print-header__name">Muhammad Suleman Saleem</h1>
          <p class="print-header__contact">
            Shahdara Town, Lahore, Pakistan &nbsp;·&nbsp; +92 307 1123666 &nbsp;·&nbsp;
            rana.suleman2297@gmail.com &nbsp;·&nbsp; linkedin.com/in/muhammad-suleman-saleem
          </p>
        </div>

        <!-- Summary -->
        <section id="summary" class="resume-section" data-aos="fade-up">
          <h2 class="resume-section__title">Professional Summary</h2>
          <p class="resume-summary">
            Full-stack Software Engineer with <strong>5+ years</strong> of experience building
            cross-platform mobile, web, and desktop applications and, more recently, production
            AI/LLM-powered systems. Deep expertise in <strong>Flutter and Dart</strong>, with
            additional cross-platform mobile experience in <strong>Expo and React Native</strong>,
            desktop development with <strong>Electron</strong>, and hands-on backend experience in
            <strong>Node.js, Nest.js, Express, and Next.js</strong>. Over the past two years I have
            shifted into building AI-integrated products — <strong>RAG pipelines</strong>,
            <strong>multi-provider LLM orchestration</strong> (Claude, OpenAI, ElevenLabs), and
            <strong>workflow automation</strong> platforms using n8n — alongside continued
            Flutter/mobile delivery. I focus on scalable architecture, clean code, and shipping
            features end-to-end, from UI to database to third-party integrations. Known for
            mentoring developers, automating repetitive business workflows, and translating
            ambiguous requirements into working production systems.
          </p>
        </section>

        <!-- Areas of Expertise -->
        <section id="skills" class="resume-section" data-aos="fade-up">
          <h2 class="resume-section__title">Areas of Expertise</h2>
          <ul class="expertise-grid expertise-grid--columns">
            <li><img src="/assets/svgs/flutter.svg" alt="" width="14" height="14" class="expertise-icon" />Flutter &amp; Dart Development</li>
            <li><img src="/assets/svgs/nodejs.svg" alt="" width="14" height="14" class="expertise-icon" />Full-Stack Development (Node.js, Nest.js, Express, Next.js)</li>
            <li><img src="/assets/svgs/rag.svg" alt="" width="14" height="14" class="expertise-icon" />AI/LLM Integration &amp; RAG Pipelines</li>
            <li><img src="/assets/svgs/clean-architecture.svg" alt="" width="14" height="14" class="expertise-icon" />Scalable App &amp; Backend Architecture</li>
            <li><img src="/assets/svgs/n8n.svg" alt="" width="14" height="14" class="expertise-icon" />Workflow Automation (n8n, App Script, Zapier, Go High Level)</li>
            <li><img src="/assets/svgs/css.svg" alt="" width="14" height="14" class="expertise-icon" />UI/UX Implementation &amp; Responsive Design</li>
            <li><img src="/assets/svgs/rest-apis.svg" alt="" width="14" height="14" class="expertise-icon" />API Integration &amp; Third-Party Services</li>
            <li><img src="/assets/svgs/firebase.svg" alt="" width="14" height="14" class="expertise-icon" />Cloud &amp; Serverless (Firebase, Supabase, AWS)</li>
            <li><img src="/assets/svgs/postgresql.svg" alt="" width="14" height="14" class="expertise-icon" />Database Management</li>
            <li><img src="/assets/svgs/stripe.svg" alt="" width="14" height="14" class="expertise-icon" />Payment &amp; Subscription Systems (Stripe)</li>
            <li><i class="ri-price-tag-3-line expertise-icon expertise-icon--generic" aria-hidden="true"></i>Native iOS &amp; Android Integrations</li>
            <li><i class="ri-price-tag-3-line expertise-icon expertise-icon--generic" aria-hidden="true"></i>Technical Leadership &amp; Mentorship</li>
            <li><i class="ri-price-tag-3-line expertise-icon expertise-icon--generic" aria-hidden="true"></i>Agile &amp; Scrum Methodologies</li>
          </ul>
        </section>

        <!-- Key Achievements -->
        <section id="achievements" class="resume-section">
          <h2 class="resume-section__title" data-aos="fade-up">Key Achievements</h2>
          <ul class="resume-list resume-card-list">
            {achievements.map((a) => (
              <li class="resume-card">
                <div class="resume-card__top">
                  <span class="resume-card__badge">{a.badge}</span>
                  <span class="resume-card__metric">{a.metric}</span>
                </div>
                <h3 class="resume-card__name">{a.name}</h3>
                <p class="resume-card__desc">{a.description}</p>
                {a.tech.length > 0 && (
                  <div class="resume-card__tech">
                    {a.tech.map((t) => (
                      <span class="tag">
                        {techIcons[t]
                          ? <img src={techIcons[t]} alt="" width="12" height="12" class="tag__icon" />
                          : <i class="ri-price-tag-3-line tag__icon tag__icon--generic" aria-hidden="true"></i>}
                        {t}
                      </span>
                    ))}
                  </div>
                )}
              </li>
            ))}
          </ul>
        </section>

        <!-- Professional Experience -->
        <section id="experience" class="resume-section">
          <h2 class="resume-section__title" data-aos="fade-up">Professional Experience</h2>

          {experienceJobs.map((job, ji) => (
            <div class="job">
              <div class="job__header" data-aos="fade-up" data-aos-delay={ji * 100}>
                <div class="job__header-main">
                  {job.logo && <img src={job.logo} alt="" width="32" height="32" class="job__logo" />}
                  <div>
                    <p class="job__title">{job.title}</p>
                    <p class="job__company">{job.company}</p>
                  </div>
                </div>
                <span class="job__dates">{job.dates}</span>
              </div>
              <ul class="resume-list resume-card-list">
                {job.items.map((item) => (
                  <li class="resume-card">
                    {(item.badge || item.metric) && (
                      <div class="resume-card__top">
                        {item.badge && <span class="resume-card__badge">{item.badge}</span>}
                        {item.metric && <span class="resume-card__metric">{item.metric}</span>}
                      </div>
                    )}
                    <h3 class="resume-card__name">{item.name}</h3>
                    <p class="resume-card__desc">{item.description}</p>
                    {item.tech.length > 0 && (
                      <div class="resume-card__tech">
                        {item.tech.map((t) => (
                          <span class="tag">
                            {techIcons[t]
                              ? <img src={techIcons[t]} alt="" width="12" height="12" class="tag__icon" />
                              : <i class="ri-price-tag-3-line tag__icon tag__icon--generic" aria-hidden="true"></i>}
                            {t}
                          </span>
                        ))}
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>

        <!-- Relevant Experience -->
        <section class="resume-section">
          <h2 class="resume-section__title" data-aos="fade-up">Relevant Experience</h2>
          <div class="job">
            <div class="job__header" data-aos="fade-up">
              <div class="job__header-main">
                {relevantExperience.logo && <img src={relevantExperience.logo} alt="" width="32" height="32" class="job__logo" />}
                <div>
                  <p class="job__title">{relevantExperience.title}</p>
                  <p class="job__company">{relevantExperience.company}</p>
                </div>
              </div>
              <span class="job__dates">{relevantExperience.dates}</span>
            </div>
            <ul class="resume-list resume-card-list">
              {relevantExperience.items.map((item) => (
                <li class="resume-card">
                  {(item.badge || item.metric) && (
                    <div class="resume-card__top">
                      {item.badge && <span class="resume-card__badge">{item.badge}</span>}
                      {item.metric && <span class="resume-card__metric">{item.metric}</span>}
                    </div>
                  )}
                  <h3 class="resume-card__name">{item.name}</h3>
                  <p class="resume-card__desc">{item.description}</p>
                  {item.tech.length > 0 && (
                    <div class="resume-card__tech">
                      {item.tech.map((t) => (
                        <span class="tag">
                          {techIcons[t]
                            ? <img src={techIcons[t]} alt="" width="12" height="12" class="tag__icon" />
                            : <i class="ri-price-tag-3-line tag__icon tag__icon--generic" aria-hidden="true"></i>}
                          {t}
                        </span>
                      ))}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </section>

        <!-- Education -->
        <section id="education" class="resume-section" data-aos="fade-up">
          <h2 class="resume-section__title">Education</h2>
          <div class="edu-list">
            <div class="edu-item">
              <div class="edu-item__left">
                <img src="/assets/logos/itu.png" alt="" width="32" height="32" class="edu-item__logo" />
                <div>
                  <p class="edu-item__degree">Bachelor of Computer Science</p>
                  <p class="edu-item__institution">Information Technology University (ITU), Lahore</p>
                  <p class="edu-item__note">FYP: Intelligent Home Automation System with Dr. Suleman Mazhar</p>
                </div>
              </div>
              <span class="edu-item__dates">2015 – 2019</span>
            </div>
