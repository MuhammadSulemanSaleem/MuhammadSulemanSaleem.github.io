  { label: 'Programming Languages', items: ['Dart', 'Java', 'Kotlin', 'Swift', 'JavaScript', 'TypeScript', 'PHP', 'Python'] },
  { label: 'Frameworks & Technologies', items: ['Flutter', 'Electron', 'Node.js', 'Nest.js', 'Express', 'Next.js', 'FlutterFlow', 'Expo', 'React Native', 'Astro'] },
  { label: 'AI / LLM', items: ['Claude API / Anthropic', 'OpenAI GPT-4o', 'ElevenLabs', 'RAG', 'MCP (Model Context Protocol)', 'ChromaDB'] },
  { label: 'Databases', items: ['PostgreSQL', 'Firebase Firestore', 'MongoDB', 'MySQL', 'Hive', 'SQLite', 'Redis'] },
  { label: 'Cloud & Serverless', items: ['Firebase (Auth, Analytics, Crashlytics)', 'Supabase', 'Google Cloud Functions', 'AWS S3'] },
  { label: 'Automation', items: ['n8n', 'Zapier', 'Google Apps Script', 'AppSheet', 'Go High Level', 'Retell AI', 'Aloware', 'CloseBot', 'Apify'] },
  { label: 'Integrations', items: ['Stripe', 'Twilio', 'SAP RFC', 'PubNub', 'JWT', 'Hunter.io', 'ZeroBounce', 'Nocodb'] },
  { label: 'Architecture & Patterns', items: ['Clean Architecture', 'MVC', 'Singleton', 'Observer'] },
  { label: 'Version Control & PM', items: ['Git', 'GitHub', 'SourceTree', 'Jira', 'Trello', 'Slack', 'Worktivity', 'ClickUp', 'Emergent Labs'] },
  { label: 'IDEs & Dev Tools', items: ['Android Studio', 'Xcode', 'Cursor', 'Visual Studio Code', 'Postman', 'Unity 3D'] },
