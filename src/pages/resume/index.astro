                    </span>
                    <span class="hc-cap-orbit__node node-left">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg>
                    </span>
                  </div>
                </div>
              )}

              {c.illustration === 'automation' && (
