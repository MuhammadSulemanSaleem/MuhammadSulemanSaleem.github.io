  <script>
    const root = document.getElementById('resume-page');
    const buttons = document.querySelectorAll<HTMLButtonElement>('.resume-toggle__btn');
    const toggle = document.querySelector<HTMLElement>('.resume-toggle');
    const hero = document.querySelector<HTMLElement>('.page-hero');
    const footer = document.querySelector<HTMLElement>('.footer');

    function setView(view: string) {
      if (view === 'card') root?.setAttribute('data-view', 'card');
      else root?.removeAttribute('data-view');
      buttons.forEach((btn) => btn.setAttribute('aria-pressed', String(btn.dataset.view === view)));
      try {
        localStorage.setItem('resumeView', view);
      } catch (e) {}
    }

    buttons.forEach((btn) => btn.addEventListener('click', () => setView(btn.dataset.view ?? 'plain')));
    setView(root?.getAttribute('data-view') === 'card' ? 'card' : 'plain');

    if (toggle) {
      const overlaps = (a: DOMRect, b: DOMRect) =>
        !(a.right < b.left || a.left > b.right || a.bottom < b.top || a.top > b.bottom);

      let ticking = false;
      const updateVisibility = () => {
        ticking = false;
        const pad = 16;
        const t = toggle.getBoundingClientRect();
        const zone = new DOMRect(t.left - pad, t.top - pad, t.width + pad * 2, t.height + pad * 2);
        const collides = [hero, footer].some((el) => el && overlaps(el.getBoundingClientRect(), zone));
        toggle.classList.toggle('resume-toggle--hidden', collides);
      };

      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(updateVisibility);
      };

      window.addEventListener('scroll', requestUpdate, { passive: true });
      window.addEventListener('resize', requestUpdate);
      updateVisibility();
    }
  </script>
</BaseLayout>
