              {c.illustration === 'code' && (
                <>
                  <div class="hc-cap-terminal">
                    <div class="hc-cap-terminal__bar">
                      <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19h8"></path><path d="m4 17 6-6-6-6"></path></svg>
