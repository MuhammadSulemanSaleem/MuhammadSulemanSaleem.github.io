---
import BaseLayout from '../../layouts/BaseLayout/index.astro';
import HcNav from '../../components/HcNav/index.astro';
import HcFooter from '../../components/HcFooter/index.astro';
import { categories } from '../../data/projects.js';
import '../../styles/hc-shared.css';
import './_work.css';

const aiProducts = categories.find((c) => c.id === 'ai').items;
const automations = categories.find((c) => c.id === 'automation').items;

const totalProjects = categories.reduce((sum, c) => sum + c.items.length, 0);

const stats = [
  { number: `${totalProjects}+`, label: 'Projects Shipped' },
  { number: `${categories.length}`, label: 'Project Categories' },
  { number: `${aiProducts.length}+`, label: 'AI & LLM Products' },
  { number: `${automations.length}+`, label: 'Automation Systems' },
];
---

<BaseLayout
  title="Work — Muhammad Suleman Saleem"
  description="Projects by Muhammad Suleman Saleem: AI products, enterprise platforms, mobile apps, automation systems, and web work."
>
  <div class="hc-page">
    <HcNav />

    <main class="hc-main">

      <!-- Hero -->
      <section class="hc-section">
        <div class="hc-card pf-hero" data-aos="fade-up">
          <div class="pf-hero__content" data-aos="fade-right" data-aos-duration="900">
            <h1 class="pf-hero__title">Projects</h1>
            <p class="pf-hero__sub">
              Production systems shipped since 2021 — from RAG-powered coaching platforms and
              SAP-integrated field-sales tools to Flutter apps reaching tens of thousands of users
              and n8n automations that replace hours of manual work. Every project below covers the
              challenge, the build, and the shipped result.
            </p>
          </div>
          <nav class="pf-directory" aria-label="Jump to category" data-aos="fade-left" data-aos-delay="200" data-aos-duration="900">
            {categories.map((c) => (
              <a href={`#${c.id}`} class="pf-directory__row">
                <span class="pf-directory__mark"><i class={c.icon} aria-hidden="true"></i></span>
                <span class="pf-directory__label">{c.title}</span>
              </a>
            ))}
          </nav>
        </div>
      </section>

      <!-- Stats -->
      <section class="hc-section hc-section--tight">
        <div class="hc-card hc-stats" data-aos="fade-up">
          {stats.map((s) => (
            <div class="hc-stat">
              <span class="hc-stat__number">{s.number}</span>
              <span class="hc-stat__label">{s.label}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Categories -->
      {categories.map((cat) => (
        <section class="hc-section pf-category" id={cat.id}>
          <div class="hc-section__header hc-section__header--left" data-aos="fade-up">
            <h2 class="hc-heading">{cat.title}</h2>
            <p class="hc-section__subtitle">{cat.blurb}</p>
          </div>

          {cat.items.map((p, i) => (
            <div class="hc-card hc-work" data-aos="fade-up">
              <div class="hc-work__content">
                <h3 class="hc-work__name">{p.name}</h3>
                <dl class={`hc-work__breakdown ${i % 2 === 1 ? 'hc-work__breakdown--violet' : ''}`}>
                  <div class="hc-work__point">
                    <dt>Challenge</dt>
                    <dd>{p.challenge}</dd>
                  </div>
                  <div class="hc-work__point">
                    <dt>Solution</dt>
                    <dd>{p.solution}</dd>
                  </div>
                  <div class="hc-work__point">
                    <dt>Impact</dt>
                    <dd>{p.impact}</dd>
                  </div>
                </dl>
                {p.note && (
                  <p class="pf-note"><i class="ri-lock-line" aria-hidden="true"></i> {p.note}</p>
                )}
                <a href={`/work/${p.slug}`} class="hc-work__actions">
                  <span class="hc-btn hc-btn--primary hc-btn--sm">Case Study</span>
                  <span class="hc-icon-btn hc-reverse-icon-btn" aria-hidden="true">
                    <span class="hc-icon-btn__track">
                      <i class="ri-arrow-right-line" aria-hidden="true"></i>
                      <i class="ri-arrow-right-line" aria-hidden="true"></i>
                    </span>
                  </span>
                </a>
              </div>
              <div class={`hc-work__tile hc-work__tile--${i % 2 === 1 ? 'violet' : 'blue'} ${p.screenshot ? 'hc-work__tile--logo' : ''}`}>
                {p.screenshot ? (
                  <img
                    src={p.screenshot}
                    alt={`${p.name} preview`}
                    class={`hc-work__tile-logo ${p.slug === 'creative-os' ? 'hc-work__tile-logo--zoom' : ''} ${p.slug === 'unity-desktop-admin-portal' || p.slug === 'houzibuilder' || p.slug === 'attn-agency-homepage' ? 'hc-work__tile-logo--up' : ''}`}
                  />
                ) : (
                  <>
                    <span class="hc-work__mark">{p.mark}</span>
                    <span class="hc-work__tile-name">{p.name}</span>
                    <span class="hc-work__tile-metric">{p.metric}</span>
                  </>
                )}
              </div>
            </div>
          ))}
        </section>
      ))}

      <!-- CTA band -->
      <section class="hc-section">
        <div class="hc-card hc-cta" data-aos="fade-up">
          <div class="hc-cta__dots" aria-hidden="true"></div>
          <div class="hc-cta__content">
            <p class="hc-cta__status"><span class="hc-cta__dot"></span>Available for work</p>
            <h2 class="hc-heading">Got a project like these<br />in mind?</h2>
            <p class="hc-cta__subtitle">Let's talk about what you're building and how I can help ship it.</p>
          </div>
          <div class="hc-cta__actions">
            <a href="/contact" class="hc-btn hc-btn--primary">Get in touch</a>
          </div>
        </div>
      </section>

    </main>

    <HcFooter />
  </div>

  <script>
    const hcStatNumbers = document.querySelectorAll<HTMLElement>('.hc-stat__number');
    const hcPrefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLAnchorElement>('.pf-directory__row').forEach((link) => {
      link.addEventListener('click', (e) => {
        const id = link.getAttribute('href')?.slice(1);
        const target = id ? document.getElementById(id) : null;
        if (!target) return;

        e.preventDefault();
        target.scrollIntoView({
          behavior: hcPrefersReducedMotion ? 'auto' : 'smooth',
          block: 'start',
        });
        history.pushState(null, '', `#${id}`);
      });
    });

    if (!hcPrefersReducedMotion && hcStatNumbers.length) {
      const animateCount = (el: HTMLElement) => {
        const match = el.textContent?.trim().match(/^(\d+)(.*)$/);
        if (!match) return;
        const target = parseInt(match[1], 10);
        const suffix = match[2];
        const duration = 1100;
        const start = performance.now();

        const step = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = `${Math.round(eased * target)}${suffix}`;
          if (progress < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };

      const hcStatsObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animateCount(entry.target as HTMLElement);
              hcStatsObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.4 }
      );

      hcStatNumbers.forEach((el) => hcStatsObserver.observe(el));
    }
  </script>
</BaseLayout>
