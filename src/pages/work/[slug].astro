---
import BaseLayout from '../../layouts/BaseLayout/index.astro';
import HcNav from '../../components/HcNav/index.astro';
import HcFooter from '../../components/HcFooter/index.astro';
import { allProjects } from '../../data/projects.js';
import { techIcons } from '../../data/techIcons.js';
import { projectScreenshots } from '../../data/screenshots.js';
import '../../styles/hc-shared.css';
import './_work.css';
import './_case-study.css';

export function getStaticPaths() {
  function getTint(p) {
    const tintIndex = p.category.items.findIndex((item) => item.slug === p.slug);
    return tintIndex % 2 === 1 ? 'violet' : 'blue';
  }
  return allProjects.map((project, i) => {
    const prev = allProjects[(i - 1 + allProjects.length) % allProjects.length];
    const next = allProjects[(i + 1) % allProjects.length];
    return {
      params: { slug: project.slug },
      props: {
        project,
        prev,
        next,
        tint: getTint(project),
        prevTint: getTint(prev),
        nextTint: getTint(next),
      },
    };
  });
}

const { project, prev, next, tint, prevTint, nextTint } = Astro.props;
const heroDescription = project.heroDescription ?? project.overview.split('\n\n')[0];
const shots = projectScreenshots[project.slug];

function renderTech(t) {
  return techIcons[t] ?? null;
}
---

<BaseLayout
  title={`${project.name} — Case Study — Muhammad Suleman Saleem`}
  description={project.impact}
>
  <div class="hc-page">
    <HcNav />

    <main class="hc-main">

      <!-- Hero -->
      <section class="hc-section">
        <div class={`hc-card cs-hero ${shots ? `cs-hero--${tint}` : ''}`} data-aos="fade-up">
          <div class="cs-hero__content" data-aos="fade-right" data-aos-duration="900">
            <h1 class="cs-hero__title">{project.name}</h1>
            <p class="cs-hero__desc">{heroDescription}</p>
            {project.note && (
              <p class="cs-callout"><i class="ri-lock-line" aria-hidden="true"></i> {project.note}</p>
            )}
          </div>
          {shots ? (
            <div class="cs-hero__shot-wrap" data-aos="fade-left" data-aos-delay="200" data-aos-duration="900">
              <img
                src={shots.hero.src}
                alt={shots.hero.alt}
                class={`cs-hero__mockup ${project.slug === 'creative-os' ? 'cs-hero__mockup--zoom' : ''}`}
                loading="lazy"
              />
            </div>
          ) : (
            <div class={`hc-work__tile hc-work__tile--${tint} ${project.logo ? 'hc-work__tile--logo' : ''}`} data-aos="fade-left" data-aos-delay="200" data-aos-duration="900">
              {project.logo ? (
                <img src={project.logo} alt={`${project.name} logo`} class="hc-work__tile-logo" />
              ) : (
                <>
                  <span class="hc-work__mark">{project.mark}</span>
                  <span class="hc-work__tile-name">{project.name}</span>
                  <span class="hc-work__tile-metric">{project.metric}</span>
                </>
              )}
            </div>
          )}
        </div>
      </section>

      <!-- Tech stack -->
      <section class="hc-section hc-section--tight">
        <div class="hc-card cs-stack" data-aos="fade-up">
          <p class="hc-eyebrow"><i class="ri-stack-line" aria-hidden="true"></i> Built With</p>
          <div class="cs-stack__tags">
            {project.stack.map((t) => (
              <span class="cs-tag">
                {renderTech(t)
                  ? <img src={renderTech(t)} alt="" width="18" height="18" />
                  : <i class="ri-price-tag-3-line" aria-hidden="true"></i>}
                {t}
              </span>
            ))}
          </div>
        </div>
      </section>

      <!-- Detailed project overview -->
      <section class="hc-section hc-section--tight">
        <div class="hc-section__header hc-section__header--left" data-aos="fade-up">
          <h2 class="hc-heading">Project Overview</h2>
        </div>
        <div class="hc-card cs-detail" data-aos="fade-up">
          {project.overview.split('\n\n').map((para) => (
            <p class="cs-detail__text">{para}</p>
          ))}
        </div>
      </section>

      <!-- Screenshot marquee -->
      {shots && shots.gallery.length > 0 && (
        <section class="hc-section hc-section--tight">
          <div class="cs-marquee" data-aos="fade-up" data-marquee>
            <button type="button" class="cs-marquee__arrow cs-marquee__arrow--prev" aria-label="Show previous screenshot" data-marquee-prev>
              <i class="ri-arrow-left-s-line" aria-hidden="true"></i>
            </button>
            <div class="cs-marquee__viewport">
              <div class="cs-marquee__track" data-marquee-track>
                {shots.gallery.map((shot) => (
                  <div class="cs-marquee__frame">
                    <img src={shot.src} alt={shot.alt} loading="lazy" />
                  </div>
                ))}
                {shots.gallery.map((shot) => (
                  <div class="cs-marquee__frame" aria-hidden="true">
                    <img src={shot.src} alt="" loading="lazy" />
                  </div>
                ))}
              </div>
            </div>
            <button type="button" class="cs-marquee__arrow cs-marquee__arrow--next" aria-label="Show next screenshot" data-marquee-next>
              <i class="ri-arrow-right-s-line" aria-hidden="true"></i>
            </button>
          </div>
        </section>
      )}

      <!-- Challenge / Solution / Impact breakdown -->
      <section class="hc-section hc-section--tight">
        <div class="hc-card cs-overview" data-aos="fade-up">
          <dl class={`hc-work__breakdown cs-overview__breakdown ${tint === 'violet' ? 'hc-work__breakdown--violet' : ''}`}>
            <div class="hc-work__point">
              <dt>Challenge</dt>
              <dd>{project.challengeDetail}</dd>
            </div>
            <div class="hc-work__point">
              <dt>Solution</dt>
              <dd>{project.solutionDetail}</dd>
            </div>
            <div class="hc-work__point">
              <dt>Impact</dt>
              <dd>{project.impactDetail}</dd>
            </div>
          </dl>
        </div>
      </section>

      <!-- Prev / Next -->
      <section class="hc-section hc-section--tight">
        <div class="cs-nav" data-aos="fade-up">
          <a href={`/work/${prev.slug}`} class="hc-card cs-nav__link cs-nav__link--prev">
            <span class={`cs-nav__mark cs-nav__mark--${prevTint}`}>{prev.mark}</span>
            <span class="cs-nav__body">
              <span class="cs-nav__dir"><i class="ri-arrow-left-line" aria-hidden="true"></i> Previous project</span>
              <span class="cs-nav__name">{prev.name}</span>
              <span class="cs-nav__cat">{prev.category.title}</span>
            </span>
          </a>
          <a href={`/work/${next.slug}`} class="hc-card cs-nav__link cs-nav__link--next">
            <span class="cs-nav__body">
              <span class="cs-nav__dir">Next project <i class="ri-arrow-right-line" aria-hidden="true"></i></span>
              <span class="cs-nav__name">{next.name}</span>
              <span class="cs-nav__cat">{next.category.title}</span>
            </span>
            <span class={`cs-nav__mark cs-nav__mark--${nextTint}`}>{next.mark}</span>
          </a>
        </div>
      </section>

      <!-- CTA band -->
      <section class="hc-section">
        <div class="hc-card hc-cta" data-aos="fade-up">
          <div class="hc-cta__dots" aria-hidden="true"></div>
          <div class="hc-cta__content">
            <p class="hc-cta__status"><span class="hc-cta__dot"></span>Available for work</p>
            <h2 class="hc-heading">Got a project like this<br />in mind?</h2>
            <p class="hc-cta__subtitle">Let's talk about what you're building and how I can help ship it.</p>
          </div>
          <div class="hc-cta__actions">
            <a href="/contact" class="hc-btn hc-btn--primary">Get in touch</a>
          </div>
        </div>
      </section>

    </main>

    <HcFooter />
  </div>

  <script>
    document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((marquee) => {
      const track = marquee.querySelector<HTMLElement>('[data-marquee-track]');
      const prevBtn = marquee.querySelector<HTMLButtonElement>('[data-marquee-prev]');
      const nextBtn = marquee.querySelector<HTMLButtonElement>('[data-marquee-next]');
      if (!track) return;

      const frames = Array.from(track.children) as HTMLElement[];
      const frameCount = frames.length / 2;
      const relOffset = (i: number) => frames[i].offsetLeft - frames[0].offsetLeft;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const loopWidth = () => track.scrollWidth / 2;

      let pos = 0;
      let hovered = false;
      let nudging = false;
      const speed = 0.5;

      function tick() {
        if (!reduceMotion && !hovered && !nudging) {
          pos -= speed;
          const lw = loopWidth();
          if (pos <= -lw) pos += lw;
          track!.style.transform = `translateX(${pos}px)`;
        }
        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);

      marquee.addEventListener('mouseenter', () => { hovered = true; });
      marquee.addEventListener('mouseleave', () => { hovered = false; });

      function nudge(dir: 1 | -1) {
        nudging = true;
        const lw = loopWidth();
        const travelled = ((-pos % lw) + lw) % lw;

        // Find the frame currently leading the viewport, then target its neighbor's
        // exact left edge — a fixed pixel step doesn't work here since frames have
        // different widths (screenshots with different aspect ratios), so it would
        // over/undershoot the next frame instead of aligning to it.
        let idx = 0;
        for (let i = 0; i < frameCount; i++) {
          if (relOffset(i) <= travelled + 1) idx = i;
        }
        const targetIdx = idx + dir;
        const targetOffset =
          targetIdx < 0 ? relOffset(frameCount - 1) - lw
          : targetIdx >= frameCount ? relOffset(frameCount)
          : relOffset(targetIdx);

        pos = -targetOffset;
        if (pos <= -lw) pos += lw;
        if (pos > 0) pos -= lw;

        track!.style.transition = 'transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)';
        track!.style.transform = `translateX(${pos}px)`;
        window.setTimeout(() => {
          track!.style.transition = 'none';
          nudging = false;
        }, 500);
      }

      prevBtn?.addEventListener('click', () => nudge(-1));
      nextBtn?.addEventListener('click', () => nudge(1));
    });
  </script>
</BaseLayout>
