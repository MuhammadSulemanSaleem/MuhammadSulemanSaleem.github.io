  <script>
    const hcNav = document.querySelector<HTMLElement>('.hc-nav');

    if (hcNav) {
      let hcLastScrollY = window.scrollY;
      let hcTicking = false;

      const hcUpdateNav = () => {
        const currentY = window.scrollY;
        if (currentY > hcLastScrollY && currentY > 80) {
          hcNav.classList.add('hc-nav--hidden');
        } else if (currentY < hcLastScrollY) {
          hcNav.classList.remove('hc-nav--hidden');
        }
        hcLastScrollY = currentY;
        hcTicking = false;
      };

      window.addEventListener(
        'scroll',
        () => {
          if (!hcTicking) {
            requestAnimationFrame(hcUpdateNav);
            hcTicking = true;
          }
        },
        { passive: true }
      );
    }
  </script>

  <script>
    const hcStatNumbers = document.querySelectorAll<HTMLElement>('.hc-stat__number');
    const hcPrefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!hcPrefersReducedMotion && hcStatNumbers.length) {
      const animateCount = (el: HTMLElement) => {
        const match = el.textContent?.trim().match(/^(\d+)(.*)$/);
        if (!match) return;
        const target = parseInt(match[1], 10);
        const suffix = match[2];
        const duration = 1100;
        const start = performance.now();

        const step = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = `${Math.round(eased * target)}${suffix}`;
          if (progress < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };

      const hcStatsObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animateCount(entry.target as HTMLElement);
              hcStatsObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.4 }
      );

      hcStatNumbers.forEach((el) => hcStatsObserver.observe(el));
    }
  </script>
</BaseLayout>
