    },
  ];

  return certs.map((cert) => ({
    params: { slug: cert.slug },
    props: { cert },
  }));
}

const { cert } = Astro.props as { cert: Cert };
---

<BaseLayout
  title={`${cert.shortTitle ?? cert.title} Certificate | Muhammad Suleman Saleem`}
  description={`${cert.title} certificate issued by ${cert.issuer}.`}
>
  <main class="cert-viewer">
    <header class="cert-viewer__bar">
      <a href="/about#certifications" class="cert-viewer__back">
        <i class="ri-arrow-left-line" aria-hidden="true"></i> Back to Resume
      </a>
      <div class="cert-viewer__info">
        <img src={cert.issuerIcon} alt={`${cert.issuer} logo`} width="16" height="16" />
        <h1 class="cert-viewer__title">{cert.title}</h1>
      </div>
      <div class="cert-viewer__actions">
        <a href={cert.verifyUrl} target="_blank" rel="noopener noreferrer" class="cert-viewer__verify">
          <i class="ri-shield-check-line" aria-hidden="true"></i> Verify
        </a>
        <a href={cert.pdf} download class="cert-viewer__download">
          <i class="ri-download-2-line" aria-hidden="true"></i> Download
        </a>
      </div>
    </header>
    <iframe
      src={cert.pdf}
      class="cert-viewer__frame"
      title={`${cert.title} certificate PDF`}
    ></iframe>
  </main>
</BaseLayout>
