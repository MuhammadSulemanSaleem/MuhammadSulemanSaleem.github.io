---
import './Hero.css';
---

<section class="section">
  <div class="section__container">
    <div class="content">
      <p class="subtitle">HELLO</p>
      <h1 class="title">
        I'm <span>Suleman<br />a</span> Software Developer
      </h1>
      <p class="description">
        Welcome to my developer portfolio! I'm Suleman, a skilled and creative
        software developer with a passion for creating beautiful, responsive,
        and user-friendly applications. I've worked on a variety of projects,
        ranging from mobile applications to desktop applications.
      </p>
      <div class="action__btns">
        <button class="hire__me">Hire Me</button>
        <button class="portfolio__btn">Portfolio</button>
      </div>
    </div>
    <div class="dev-gif">
      <img src="/assets/gifs/animated-code.gif" alt="Developer coding animation" />
    </div>
  </div>
</section>
