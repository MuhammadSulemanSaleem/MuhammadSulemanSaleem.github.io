---
import './Skills.css';
import { techIcons } from '../../data/techIcons.js';

const categories = [
  {
    icon: 'ri-smartphone-line',
    label: 'Mobile & Frontend',
    skills: ['Flutter', 'React Native','Dart', 'FlutterFlow', 'Expo', 'TypeScript', 'JavaScript'],
  },
  {
    icon: 'ri-server-line',
    label: 'Backend & APIs',
    skills: ['WebSockets', 'JWT', 'REST APIs', 'Node.js', 'Nest.js', 'Next.js', 'Express'],
  },
  {
    icon: 'ri-robot-line',
    label: 'AI & LLM',
    skills: ['LLM Orchestration', 'RAG', 'OpenAI GPT-4o', 'MCP', 'Claude API', 'ChromaDB', 'ElevenLabs'],
  },
  {
    icon: 'ri-flow-chart',
    label: 'Automation',
    skills: ['Google Apps Script', 'n8n', 'Go High Level', 'Apify', 'Retell AI', 'Zapier', 'AppSheet'],
  },
  {
    icon: 'ri-database-2-line',
    label: 'Databases & Cloud',
    skills: ['PostgreSQL', 'Redis', 'Firebase', 'AWS S3', 'Supabase', 'SQLite', 'MongoDB'],
  },
  {
    icon: 'ri-macbook-line',
    label: 'Desktop & Web',
    skills: ['Go High Level', 'Astro', 'WordPress', 'Electron', 'Next.js'],
  },
  {
    icon: 'ri-bank-card-line',
    label: 'Payments & Integrations',
    skills: ['SAP ERP / RFC', 'Stripe', 'OneSignal', 'PubNub', 'Hunter.io', 'Twilio', 'ZeroBounce'],
  },
  {
    icon: 'ri-layout-grid-line',
    label: 'Architecture & Patterns',
    skills: ['Clean Architecture', 'MVC', 'Bloc', 'Singleton', 'Observer', 'Agile / Scrum'],
  },
];
---

<section class="skills" id="skills">
  <div class="skills__container">
    <div class="skills__header" data-aos="fade-up">
      <p class="section__label">Technical Skills</p>
      <h2 class="section__heading">Full-Stack Across the Modern Stack</h2>
    </div>
    <div class="skills__grid">
      {categories.map((cat, i) => (
        <div class="skill-card" data-aos="fade-up" data-aos-delay={100 + i * 80}>
          <div class="skill-card__header">
            <i class={cat.icon} aria-hidden="true"></i>
            <h3>{cat.label}</h3>
          </div>
          <div class="skill-card__tags">
            {cat.skills.map((s) => (
              <span class="tag">
                {techIcons[s]
                  ? <img src={techIcons[s]} alt="" width="12" height="12" class="tag__icon" />
                  : <i class="ri-price-tag-3-line tag__icon tag__icon--generic" aria-hidden="true"></i>}
                {s}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
