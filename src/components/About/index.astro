---
import './About.css';
---

<section class="about" id="about">
  <div class="about__container">

    <!-- Stats bar -->
    <div class="about__stats" data-aos="fade-up">
      <div class="stat">
        <span class="stat__number">5+</span>
        <span class="stat__label">Years Experience</span>
      </div>
      <div class="stat__divider" aria-hidden="true"></div>
      <div class="stat">
        <span class="stat__number">15+</span>
        <span class="stat__label">Projects Shipped</span>
      </div>
      <div class="stat__divider" aria-hidden="true"></div>
      <div class="stat">
        <span class="stat__number">53K+</span>
        <span class="stat__label">App Users Reached</span>
      </div>
      <div class="stat__divider" aria-hidden="true"></div>
      <div class="stat">
        <span class="stat__number">10+</span>
        <span class="stat__label">Automations Deployed</span>
      </div>
    </div>

    <!-- Bio -->
    <div class="about__bio" data-aos="fade-up" data-aos-delay="150">
      <p class="section__label">About Me</p>
      <h2 class="section__heading">Full-Stack Engineer who ships AI to production</h2>
      <p>
        I'm a Full-Stack Software Engineer and AI Product Engineer based in Lahore, Pakistan.
        Since 2021 I've been building cross-platform mobile and web applications — working
        across Flutter, React Native, Node.js, and Electron. Over the past two years my focus
        has shifted into production AI systems: RAG pipelines, multi-provider LLM orchestration,
        and workflow automations that replace manual hours with reliable, always-on processes.
      </p>
      <p>
        At <strong>Techtiz</strong> I lead engineering on products like
        <strong>NebuFit</strong> (AI fitness platform with computer-vision body analysis and
        voice coaching) and <strong>Creative OS</strong> (local-first AI desktop app for
        filmmakers using Claude API and MCP). Before that, at <strong>BooleanBites</strong>
        I built <strong>Houzi</strong> — a real estate Flutter app developed for
        <strong>Houzez</strong>, a WordPress real estate theme used by 53,000+ people
        globally, with a 4.84/5 rating and 500+ Envato sales.
      </p>
      <p>
        I care about clean architecture, well-structured code, and shipping features
        end-to-end — from UI to database to third-party integrations. When the build
        is good, users just notice it works.
      </p>
      <div class="about__links">
        <a href="/portfolio" class="about__link">View Projects &rarr;</a>
      </div>
    </div>

  </div>
</section>

<script>
  const statNumbers = document.querySelectorAll<HTMLElement>('.stat__number');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion && statNumbers.length) {
    const animateCount = (el: HTMLElement) => {
      const match = el.textContent?.trim().match(/^(\d+)(.*)$/);
      if (!match) return;
      const target = parseInt(match[1], 10);
      const suffix = match[2];
      const duration = 1100;
      const start = performance.now();

      const step = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = `${Math.round(eased * target)}${suffix}`;
        if (progress < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const statsObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCount(entry.target as HTMLElement);
            statsObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 }
    );

    statNumbers.forEach((el) => statsObserver.observe(el));
  }
</script>
